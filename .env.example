# Copia este archivo a apps/api/.env para desarrollo local.
# Los valores por defecto ya coinciden con docker-compose.yml — con
# `docker compose up -d` + `cp .env.example apps/api/.env` la API funciona
# sin credenciales de proveedores externos (ver docs/PLANNING.md §4).

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
MOBILE_DEEP_LINK_BASE=faro://

DATABASE_URL=postgresql://faro:faro_dev_password@localhost:5432/faro?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-please-use-a-long-random-value
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-a-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

MIN_AGE=13

# Object storage compatible S3 — en local, MinIO (ver docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=faro_dev
S3_SECRET_ACCESS_KEY=faro_dev_secret
S3_BUCKET=faro-videos
S3_PUBLIC_URL=http://localhost:9000/faro-videos
S3_FORCE_PATH_STYLE=true

# SMTP opcional — sin configurar, los emails se escriben en storage/dev-outbox/ y en consola
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Faro <no-reply@faro.app>"

# OAuth social opcional — sin configurar, /auth/google y /auth/apple responden 501
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Push notifications (Expo) — opcional
EXPO_ACCESS_TOKEN=

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
